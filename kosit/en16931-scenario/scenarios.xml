<?xml version="1.0" encoding="UTF-8"?>
<!--
  Isolated KoSIT scenario package for the invoicesuite demo.

  Derived from the generic "EN16931 (CII)" scenario found in the official
  KoSIT "Validator Configuration XRechnung 3.0.2" package (see var/kosit-default/,
  generated through step 2), which already matches only the pure EN 16931 profile
  (without any superimposed XRechnung CIUS rules). This package retains only that
  scenario and replaces the embedded CEN Schematron (1.3.15, from the
  XRechnung 2026-01-31 bundle) with the most recent official artifact
  published by ConnectingEurope/eInvoicing-EN16931: tag validation-1.3.16 (2026-04-13).

  Artifact sources:
  - XSD CII D16B (resources/cii/16b/xsd/): copied as-is from the KoSIT
    package (generic UN/CEFACT schema, not specific to XRechnung or EN16931).
  - XSLT Schematron (resources/cii/16b/xsl/EN16931-CII-validation.xslt):
    https://raw.githubusercontent.com/ConnectingEurope/eInvoicing-EN16931/validation-1.3.16/cii/xslt/EN16931-CII-validation.xslt
    (EUPL 1.2, officially provided compiled XSLT 2.0 from CEF - not
    recompiled from the source .sch, in accordance with SPECS.md §5).
  - Report stylesheet (resources/default-report.xsl): copied as-is
    from the KoSIT package (generic, not XRechnung-branded).
-->
<scenarios xmlns="http://www.xoev.de/de/validator/framework/1/scenarios"
  frameworkVersion="1.0.0">
  <name>EN16931 CII (w/o XRechnung) - Demo Invoicesuite</name>
  <author>Aleksandr Daniloff - Demo Invoicesuite</author>
  <date>2026-09-03</date>
  <description>
    <p>Validates a UN/CEFACT CII document (SCRDM uncoupled, D16B) against the pure EN 16931 profile,
     without any CIUS rules. Extracted from the KoSIT "Validator Configuration XRechnung 3.0.2"
     package and updated with the official CEF validation-1.3.16 artifact (2026-04-13).
     See the comments at the top of this file for details and sources.
    </p>
  </description>

  <scenario>
    <name>EN16931 (CII)</name>
    <description>
      <p>Validates UN/CEFACT XML (SCRDM - CII uncoupled) version D16B</p>
      <p>Uses UN/CEFACT (SCRDM - CII uncoupled) version D16B XML Schema and
        Schematron rules from EN16931:2017 version 1.3.16 (2026-04-13),
        sans règle XRechnung/CIUS.</p>
      <p>Download of CII Schematron rules (XSLT compilé officiel) on
        2026-09-03 from
        https://raw.githubusercontent.com/ConnectingEurope/eInvoicing-EN16931/validation-1.3.16/cii/xslt/EN16931-CII-validation.xslt</p>
    </description>
    <!-- CII namespaces -->
    <namespace prefix="rsm">urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100</namespace>
    <namespace prefix="ram">urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100</namespace>
    <!-- Namespace for acceptMatch XPATH within validator report XML -->
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>

    <match>exists(/rsm:CrossIndustryInvoice[ rsm:ExchangedDocumentContext/ram:GuidelineSpecifiedDocumentContextParameter/ram:ID/text() = 'urn:cen.eu:en16931:2017'])</match>
    <validateWithXmlSchema>
      <resource>
        <name>XML Schema for UN/CEFACT XML (SCRDM - CII uncoupled)</name>
        <location>resources/cii/16b/xsd/CrossIndustryInvoice_100pD16B.xsd</location>
      </resource>
    </validateWithXmlSchema>
    <validateWithSchematron>
      <resource>
        <name>Schematron rules for EN16931 (CII) 1.3.16</name>
        <location>resources/cii/16b/xsl/EN16931-CII-validation.xslt</location>
      </resource>
    </validateWithSchematron>

    <createReport>
      <resource>
        <name>Validation report for EN16931 (CII)</name>
        <location>resources/default-report.xsl</location>
      </resource>
    </createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>

  <noScenarioReport>
    <resource>
      <name>Default Report</name>
      <location>resources/default-report.xsl</location>
    </resource>
  </noScenarioReport>
</scenarios>
